# ---------------------------------------------------------------------------
# PhysioAI backend configuration (copy to backend/.env and fill in real values)
# ---------------------------------------------------------------------------

# Database connection string.
# Local development (SQLite):
DATABASE_URL=sqlite:///./physioai.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/physioai

# Secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# JWT signing algorithm and token lifetime (minutes).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma separated list of allowed browser origins (no wildcard in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Sign-in throttling (server-side; not a browser counter)
# ---------------------------------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# After this many failures the UI is told to offer "Forgot password?".
LOGIN_FORGOT_PASSWORD_THRESHOLD=3

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5

# ---------------------------------------------------------------------------
# Email delivery
#   EMAIL_BACKEND=auto    -> smtp when SMTP_HOST is set, otherwise console
#   EMAIL_BACKEND=smtp    -> always attempt real delivery
#   EMAIL_BACKEND=console -> development only: records the message server-side
#                            and logs that it was NOT delivered
# Never commit real credentials.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=auto
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_FROM_NAME=PhysioAI
SMTP_USE_TLS=true

# Legacy SQLite database that holds the pre-existing data (do not delete it).
LEGACY_DATABASE_PATH=../aiphysio.db
