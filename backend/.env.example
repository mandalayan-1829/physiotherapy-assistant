# ---------------------------------------------------------------------------
# PhysioAI backend configuration (copy to backend/.env and fill in real values)
#
# This file is a TEMPLATE. It contains placeholders only - never a real secret.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Deployment context.
#   development -> local work; console mail transport allowed; docs enabled
#   test        -> automated test suite
#   production  -> refuses to start without a real mail transport, non-localhost
#                  CORS origins, and a strong SECRET_KEY; interactive API docs
#                  are disabled
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# Database connection string.
# Local development (SQLite):
DATABASE_URL=sqlite:///./physioai.db
# Production (PostgreSQL) example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/physioai

# ---------------------------------------------------------------------------
# REQUIRED. Secret used to sign JWT access tokens.
#
# There is no default: the API fails to start if this is missing, shorter than
# 32 characters, or one of the well-known placeholder values. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Never commit the real value, and never reuse it across environments. Changing
# it invalidates every issued token.
# ---------------------------------------------------------------------------
SECRET_KEY=

# JWT signing algorithm and token lifetime (minutes). Only HMAC algorithms
# (HS256/HS384/HS512) are accepted, because tokens are signed with SECRET_KEY.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=physioai-api

# ---------------------------------------------------------------------------
# Legacy credential migration (OFF by default - leave it off unless you are
# actively importing aiphysio.db).
#
# The legacy database stored unsalted SHA-256 digests. Enabling this lets such an
# account sign in once with its old password, after which the digest is replaced
# with bcrypt. While it is off, no SHA-256 digest can authenticate.
# ---------------------------------------------------------------------------
ALLOW_LEGACY_PASSWORD_LOGIN=false

# ---------------------------------------------------------------------------
# CORS: comma separated list of allowed browser origins.
# No wildcard, and no localhost values in production. Set this to the exact
# deployed frontend origin(s), e.g.
#   CORS_ORIGINS=https://your-app.vercel.app,https://your-domain.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Serve /docs, /redoc and /openapi.json. Ignored (always off) in production.
ENABLE_API_DOCS=true

# Only enable this when a reverse proxy you control sets X-Forwarded-For.
# Otherwise the header is attacker-controlled and per-IP throttling is bypassable.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Sign-in throttling (server-side; not a browser counter)
# ---------------------------------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# After this many failures the UI is told to offer "Forgot password?".
LOGIN_FORGOT_PASSWORD_THRESHOLD=3

# Per-source (IP) throttling for the unauthenticated auth surface. The counters
# are rows in the database, so they are shared across every backend instance.
REGISTER_MAX_REQUESTS_PER_HOUR=5
LOGIN_MAX_REQUESTS_PER_IP_PER_WINDOW=30
PASSWORD_RESET_MAX_REQUESTS_PER_IP_PER_HOUR=20

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_CODE_LENGTH=6

# ---------------------------------------------------------------------------
# Email delivery
#   EMAIL_BACKEND=auto    -> smtp when SMTP_HOST is set, otherwise console
#   EMAIL_BACKEND=smtp    -> always attempt real delivery (REQUIRED in production)
#   EMAIL_BACKEND=console -> development only: records the message server-side
#                            without logging its contents. It never reports
#                            success and never writes a reset code to the logs.
#
# Any standards-compliant SMTP provider works (Resend, Brevo, SendGrid, Postmark,
# AWS SES, a corporate relay, ...), so switching vendors never touches the
# password-reset code. Port 465 is treated as implicit TLS; everything else uses
# STARTTLS when SMTP_USE_TLS is true.
#
# The verification code is emailed to the user and is never logged and never
# returned by the API.
#
# ALLOW_PRODUCTION_WITHOUT_EMAIL: off by default. In production the API refuses
# to start unless a real transport is configured, because an undeliverable reset
# code is useless. Set this to true only to accept a deliberate deployment window
# in which password reset does not work; a startup warning is logged while it is
# on. It never weakens SECRET_KEY, CORS or the JWT algorithm checks.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=auto
ALLOW_PRODUCTION_WITHOUT_EMAIL=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_FROM_NAME=PhysioAI
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---------------------------------------------------------------------------
# Clinician onboarding.
#
# A doctor account created through public registration is UNVERIFIED: it is not
# listed in the patient directory and cannot be booked or messaged until an
# operator verifies it:
#   python scripts/verify_doctor.py --list
#   python scripts/verify_doctor.py --email dr.smith@example.com
# Not to be enabled in production.
# ---------------------------------------------------------------------------
DOCTOR_DEFAULT_VERIFIED=false

# Legacy SQLite database that holds the pre-existing data (do not delete it).
# It is intentionally NOT tracked in git; keep it outside the repository or
# local-only, and read it with scripts/migrate_legacy.py.
LEGACY_DATABASE_PATH=../aiphysio.db
