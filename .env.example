# AI Physio — Environment Variables

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_PATH=./aiphysio.db

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# MediaPipe
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# Session alarm
ALARM_THRESHOLD=3
ALARM_TIMEOUT=60
