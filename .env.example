# ---------------------------------------------------------------------------
# PhysioAI frontend configuration (copy to .env)
# Only VITE_-prefixed variables are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. The frontend never hardcodes localhost.
# Local development:
VITE_API_URL=http://localhost:8000
# Production example:
# VITE_API_URL=https://api.your-physioai-domain.com

# NOTE: the backend's own settings live in backend/.env.example
# (DATABASE_URL, SECRET_KEY, CORS_ORIGINS, ...).
